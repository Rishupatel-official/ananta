# Copy this file to .env.local in the same folder as package.json.
# Firebase web app configuration only. Never put an Admin SDK private key here.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
# Flask API for the local presentation; use your HTTPS backend URL after deployment.
VITE_MODEL_API_URL=http://localhost:8000
